<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌐 Permisos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
            android:name=".MyApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.sgost"
            android:usesCleartextTraffic="true"
            android:networkSecurityConfig="@xml/network_security_config"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="31">

        <!-- 1. PANTALLA PRINCIPAL -->
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. LOGIN -->
        <activity
                android:name=".LoginActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".MainActivity" />

        <!-- 3. ADMIN (Nota: Tu archivo se llama DasbohadActivityAdmin) -->
        <activity
                android:name=".DasbohadActivityAdmin"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".LoginActivity" />

        <!-- 4. CLIENTES DASHBOARD -->
        <activity
                android:name=".DashboardActivityClientes"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".LoginActivity" />

        <!-- 5. TÉCNICOS DASHBOARD (Nota: Tu archivo se llama DasbohadActivityTecnicos) -->
        <activity
                android:name=".DasbohadActivityTecnicos"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".LoginActivity" />

        <!-- 6. GESTIÓN TÉCNICOS -->
        <activity
                android:name=".TecnicosActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".DasbohadActivityAdmin" />

        <!-- 7. FORMULARIO TÉCNICO -->
        <activity
                android:name=".FormTecnicoActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".TecnicosActivity" />

        <!-- 8. GESTIÓN CLIENTES -->
        <activity
                android:name=".ClientesActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".DasbohadActivityAdmin" />

        <!-- 9. FORMULARIO CLIENTE -->
        <activity
                android:name=".FormClienteActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".ClientesActivity" />

        <!-- 10. CARRITO -->
        <activity
                android:name=".CarritoActivity"
                android:exported="false"
                android:screenOrientation="portrait"
                android:parentActivityName=".DashboardActivityClientes" />

    </application>
</manifest>