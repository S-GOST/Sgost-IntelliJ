<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
            android:name=".MyApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.sgost"
            android:usesCleartextTraffic="true"
            android:networkSecurityConfig="@xml/network_security_config"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="31">

        <!-- 1. PANTALLA PRINCIPAL -->
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. LOGIN -->
        <activity android:name=".LoginActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 3. CARRITO -->
        <activity android:name=".CarritoActivity" android:exported="false" android:screenOrientation="portrait" android:parentActivityName=".MainActivity" />

        <!-- 4. ADMIN DASHBOARD -->
        <activity android:name=".DasbohadActivityAdmin" android:exported="false" android:screenOrientation="portrait" />

        <!-- 5. CLIENTES DASHBOARD -->
        <activity android:name=".DashboardActivityClientes" android:exported="false" android:screenOrientation="portrait" />

        <!-- 6. TÉCNICOS DASHBOARD -->
        <activity android:name=".DasbohadActivityTecnicos" android:exported="false" android:screenOrientation="portrait" />

        <!-- 7. GESTIÓN TÉCNICOS -->
        <activity android:name=".TecnicosActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 8. GESTIÓN ADMINISTRADOR -->
        <activity android:name=".AdministradoresActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 9. GESTIÓN CLIENTES -->
        <activity android:name=".ClientesActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 10. ORDENES DE SERVICIO -->
        <activity android:name=".OrdenServicioActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 11. DETALLE DE ORDEN -->
        <activity android:name=".OrdenDetalleActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 12. FORMULARIO DE ORDEN -->
        <activity android:name=".FormOrdenServicioActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 13. FORMULARIO TÉCNICO -->
        <activity android:name=".FormTecnicoActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 14. FORMULARIO CLIENTE -->
        <activity android:name=".FormClienteActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- 15. FORMULARIO ADMINISTRADORES -->
        <activity android:name=".FormAdministradorActivity" android:exported="false" android:screenOrientation="portrait" />

        <activity android:name=".ClienteLoginActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".WelcomeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".DashboardClienteActivity" android:exported="false" android:screenOrientation="portrait" />

    </application>
</manifest>