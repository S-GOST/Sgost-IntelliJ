<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0D"
        android:fillViewport="true"
        tools:context="com.example.sgost.MainActivity">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

        <!-- ══════════════ HEADER KTM ══════════════ -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SGO ST ADMIN"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FF6600"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de Control"
                android:textSize="14sp"
                android:textColor="#888888"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="24dp"/>

        <!-- ══════════════ CARD USUARIO ══════════════ -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                <!-- Avatar placeholder -->
                <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_orange_glow"
                        android:layout_marginEnd="12dp"/>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/tvAdminName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Juan Parra"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Administrador • Activo"
                            android:textColor="#FF6600"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════ GRID DE MENÚ (2 COLUMNAS) ══════════════ -->
        <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="24dp">

            <!-- Item 1: Dashboard -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDashboard"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                    <TextView android:text="📊" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:text="DASHBOARD" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:text="Resumen general" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 2: Usuarios -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUsuarios"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                    <TextView android:text="👥" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:text="USUARIOS" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:text="Gestión de cuentas" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 3: Ventas -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVentas"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                    <TextView android:text="💰" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:text="VENTAS" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:text="Facturación y pedidos" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 4: Reportes -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportes"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                    <TextView android:text="📈" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:text="REPORTES" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:text="Análisis y métricas" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 5: Configuración -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConfig"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                    <TextView android:text="⚙️" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:text="CONFIGURACIÓN" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:text="Ajustes del sistema" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 6: Soporte / Logs -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSoporte"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                    <TextView android:text="🔧" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:text="SOPORTE" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:text="Logs y mantenimiento" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- ══════════════ BOTÓN LOGOUT ══════════════ -->
        <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CERRAR SESIÓN"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-black"
                android:backgroundTint="#8B0000"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:layout_marginBottom="24dp"/>

        <!-- ══════════════ FOOTER RACING ══════════════ -->
        <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_gradient_line"
                android:layout_marginBottom="8dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY TO RACE • ADMIN PANEL"
                android:textSize="10sp"
                android:textColor="#FF6600"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>