<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0D"
        tools:context=".MainActivity">

    <!-- Logo (más abajo) -->
    <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="60dp"
            android:src="@mipmap/rock"
            android:contentDescription="Logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="16dp" />

    <!-- Título -->
    <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="KTM ROCKET SERVICE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            android:layout_marginTop="68dp"
            app:layout_constraintStart_toEndOf="@id/ivLogo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnLogin" />

    <!-- Botón INICIAR SESIÓN -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Iniciar"
            android:textSize="12sp"
            android:textAllCaps="true"
            app:backgroundTint="#FF6600"
            app:cornerRadius="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="60dp"
            app:layout_constraintEnd_toStartOf="@+id/btnRegistro"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón REGISTRARSE -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistro"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Registrar"
            android:textSize="12sp"
            android:textAllCaps="true"
            app:backgroundTint="#1A1A1A"
            app:strokeColor="#FF6600"
            app:strokeWidth="1.5dp"
            app:cornerRadius="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtítulo (opcional) -->
    <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sistema de Gestión de Órdenes de Servicio Técnico"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <!-- ProgressBar de carga -->
    <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone" />

    <!-- RecyclerView en Grid (2 columnas) -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCatalogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView en Grid (2 columnas) -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCatalogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>