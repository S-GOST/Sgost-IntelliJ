<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0D"
        android:fitsSystemWindows="true"
        tools:context=".FormOrdenServicioActivity">

    <!-- TOOLBAR KTM -->
    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="8dp"
            android:background="#141414"
            android:elevation="4dp"
            app:contentInsetStart="16dp"
            app:contentInsetStartWithNavigation="16dp"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="#FF6600"
            app:title="Gestión de Clientes"
            app:titleTextColor="#FFFFFF"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <!-- CONTENIDO SCROLLEABLE -->
    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="72dp"
            android:clipToPadding="false"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- TARJETA CLIENTE -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">

                <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="#FF6600" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="👤 CLIENTE"
                            android:textColor="#FF6600"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <Spinner
                            android:id="@+id/spinnerClientes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="#252525"
                            android:dropDownSelector="#FF6600"
                            android:padding="12dp"
                            android:popupBackground="#222222"
                            android:spinnerMode="dropdown"
                            android:textColor="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNuevoCliente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#252525"
                            android:text="+ REGISTRAR NUEVO CLIENTE"
                            android:textColor="#FF6600"
                            app:cornerRadius="8dp"
                            app:strokeColor="#FF6600"
                            app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA MOTO -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">

                <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="#FF6600" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="🏍️ MOTO"
                            android:textColor="#FF6600"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <Spinner
                            android:id="@+id/spinnerMotos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="#252525"
                            android:dropDownSelector="#FF6600"
                            android:padding="12dp"
                            android:popupBackground="#222222"
                            android:spinnerMode="dropdown"
                            android:textColor="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNuevaMoto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#252525"
                            android:text="+ REGISTRAR NUEVA MOTO"
                            android:textColor="#FF6600"
                            app:cornerRadius="8dp"
                            app:strokeColor="#FF6600"
                            app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN ACCIÓN PRINCIPAL -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF6600"
                    android:text="➕ AGREGAR SERVICIO/PRODUCTO DESDE BD"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:elevation="4dp" />

            <!-- RESUMEN DE LA ORDEN -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="📋 RESUMEN DE LA ORDEN"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#141414"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvOrdenDetalles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:padding="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <Space
                    android:layout_width="match_parent"
                    android:layout_height="100dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRA INFERIOR -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#141414"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:padding="16dp">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#252525"
                android:text="CANCELAR"
                android:textColor="#AAAAAA"
                app:cornerRadius="8dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#FF6600"
                android:text="GUARDAR ORDEN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:elevation="4dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>