<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeColor="#2A2A2A"
        app:strokeWidth="1dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <!-- ID esperado por el Adapter -->
            <TextView
                    android:id="@+id/tvNombreItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Servicio/Producto"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- ID esperado por el Adapter -->
            <TextView
                    android:id="@+id/etTipoDoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo: Producto"
                    android:textColor="#FF6600"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                <!-- ID esperado por el Adapter -->
                <TextView
                        android:id="@+id/tvPrecioUnitario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$0.00 / unidad"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />

                <!-- ID esperado por el Adapter (usa este nombre para no romper el Kotlin) -->
                <TextView
                        android:id="@+id/tvPrecio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cant: 1"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp" />
            </LinearLayout>

            <!-- ID esperado por el Adapter -->
            <TextView
                    android:id="@+id/tvSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtotal: $0.00"
                    android:textColor="#FF6600"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ID esperado por el Adapter -->
        <ImageButton
                android:id="@+id/btnEliminar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#FF4444"
                android:contentDescription="Eliminar" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>