<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="wrap_content"
                                                   android:layout_marginBottom="8dp"
                                                   app:cardBackgroundColor="#1A1A1A"
                                                   app:cardCornerRadius="12dp"
                                                   app:strokeColor="#2A2A2A"
                                                   app:strokeWidth="1dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

        <TextView
                android:id="@+id/tvTipoIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="🔧"
                android:textSize="20dp"
                android:gravity="center"
                android:layout_marginEnd="12dp"/>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/tvNombreItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del servicio/producto"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            <TextView
                    android:id="@+id/tvCategoriaItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoría / Marca"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

            <TextView
                    android:id="@+id/tvPrecioUnitario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="$180.000 / unidad"
                    android:textColor="#FF6600"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

            <TextView
                    android:id="@+id/tvSubtotalItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$180.000"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            <ImageButton
                    android:id="@+id/btnEliminarItem"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_delete"
                    android:contentDescription="Eliminar"
                    android:tint="#FF5555"
                    android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>