<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#2A2A2A"
        app:strokeWidth="1dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

        <!-- AVATAR / ICONO -->
        <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/iconocliente"
                android:scaleType="centerCrop"
                android:contentDescription="Icono de usuario"
                android:layout_marginEnd="12dp" />

        <!-- INFO TÉCNICO -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/tvTecNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Carlos Méndez"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

            <TextView
                    android:id="@+id/tvTecDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CC: 1234567890"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            <TextView
                    android:id="@+id/tvTecEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● Activo"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ACCIONES -->
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

            <ImageButton
                    android:id="@+id/btnEditar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="Editar técnico"
                    android:tint="#FF6600"
                    android:layout_marginEnd="8dp" />

            <ImageButton
                    android:id="@+id/btnEliminar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_delete"
                    android:contentDescription="Eliminar técnico"
                    android:tint="#FF5555" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>