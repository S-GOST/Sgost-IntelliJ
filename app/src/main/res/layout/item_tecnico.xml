<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:strokeColor="#2A2A2A"
        app:strokeWidth="1dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

        <!-- AVATAR / ICONO -->
        <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_orange_glow"
                android:layout_marginEnd="14dp" />

        <!-- INFO TÉCNICO -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/tvTecNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carlos Méndez"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

            <TextView
                    android:id="@+id/tvTecDocumento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CC: 1234567890"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />

            <TextView
                    android:id="@+id/tvTecEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Activo"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ACCIONES (Editar / Eliminar) -->
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

            <ImageButton
                    android:id="@+id/btnEditar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="Editar técnico"
                    android:tint="#FF6600"
                    android:layout_marginEnd="8dp" />

            <ImageButton
                    android:id="@+id/btnEliminar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_delete"
                    android:contentDescription="Eliminar técnico"
                    android:tint="#FF5555" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>