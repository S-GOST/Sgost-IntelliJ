<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="10dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

        <!-- Ícono -->
        <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/readi"
                android:contentDescription="Icono detalle" />

        <!-- Columna Izquierda -->
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

            <TextView
                    android:id="@+id/tvNombreItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Motorex Aceite"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tvGarantia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="35 días de garantía"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            <TextView
                    android:id="@+id/tvPrecioUnitario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="$ 120.000 / unidad"
                    android:textColor="#FF6600"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Precio Total (Arriba a la derecha) -->
        <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 120.000"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>