<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#2A2A2A"
        app:strokeWidth="1dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

        <!-- Fila 1: Servicio + Imagen del Producto -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <TextView
                    android:id="@+id/tvTipo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nombre del Servicio"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <!-- IMAGEN DEL PRODUCTO (Mipmap) -->
            <ImageView
                    android:id="@+id/ivProductoIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@mipmap/readi" /> <!-- Icono por defecto temporal -->
        </LinearLayout>

        <!-- Fila 2: Detalle del Producto (Texto) -->
        <TextView
                android:id="@+id/tvProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Detalle del producto"
                android:textColor="#A0A0A0"
                android:textSize="12sp"
                android:visibility="gone" />

        <!-- Fila 3: Precio + Garantía -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

            <TextView
                    android:id="@+id/tvPrecio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="$0.00"
                    android:textColor="#FF6600"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

            <TextView
                    android:id="@+id/tvGarantia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin garantía"
                    android:textColor="#888888"
                    android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>