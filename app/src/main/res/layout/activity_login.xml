<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0D0D0D"
            android:fillViewport="true"
            tools:context="com.example.sgost.LoginActivityAdmin">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

        <!-- LOGO -->
        <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@mipmap/rock"
                android:scaleType="centerInside"
                android:contentDescription="Logo SGOST"
                android:layout_marginBottom="12dp" />

        <!-- TÍTULO SGOST -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SGOST"
                android:textColor="#FF6600"
                android:textSize="44sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="4dp" />

        <!-- SUBTÍTULO -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar Sesión"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginBottom="40dp" />

        <!-- TARJETA DE ACCESO -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                <!-- CORREO -->
                <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="#141414"
                        app:hintTextColor="#FF6600"
                        app:boxStrokeColor="#FF6600"
                        android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Correo electrónico"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="16sp"
                            android:inputType="textEmailAddress"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CONTRASEÑA -->
                <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="#141414"
                        app:hintTextColor="#FF6600"
                        app:boxStrokeColor="#FF6600"
                        app:endIconMode="password_toggle"
                        android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contraseña"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666666"
                            android:textSize="16sp"
                            android:inputType="textPassword"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- BOTÓN (usa color sólido para evitar errores de drawable) -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="#FF6600"
                        android:text="INICIAR SESIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        app:cornerRadius="14dp"
                        android:elevation="2dp" />

                <!-- MENSAJE DE ERROR -->
                <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="#2A1A1A"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text=""
                        android:textColor="#FF8888"
                        android:textSize="14sp"
                        android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>