<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0D"
        android:fillViewport="true"
        tools:context="com.example.sgost.LoginActivity">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="30dp">

        <!-- ══════════════ HEADER KTM ══════════════ -->
        <!-- ══════════════ HEADER KTM ══════════════ -->
        <!-- ══════════════ HEADER CON LOGO ══════════════ -->
        <ImageView
                android:id="@+id/ivLogoKtm"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="12dp"
                android:src="@mipmap/rock"
                android:contentDescription="Logo KTM"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:shadowColor="#FF6600"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:text="KTM"
                android:textColor="#FF6600"
                android:textSize="56sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.9"
                android:text="SGOST"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:fontFamily="sans-serif-light"
                android:text="Ride. Connect. Conquer."
                android:textColor="#888888"
                android:textSize="12sp" />

        <!-- ══════════════ FORMULARIO ══════════════ -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="28dp">

            <!-- Email -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="CORREO ELECTRÓNICO"
                    android:textColor="#FF6600"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_input_dark"
                    android:fontFamily="sans-serif"
                    android:hint="rider@ktm.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:textSize="14sp" />

            <!-- Contraseña -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="CONTRASEÑA"
                    android:textColor="#FF6600"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_input_dark"
                    android:fontFamily="sans-serif"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:textSize="14sp" />

            <!-- Botón Login -->
            <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_btn_ktm"
                    android:elevation="6dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1"
                    android:stateListAnimator="@null"
                    android:text="INICIAR SESIÓN"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            <!-- Mensaje de Error -->
            <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_error_box"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text=""
                    android:textColor="#FF4444"
                    android:textSize="13sp"
                    android:visibility="gone" />
        </LinearLayout>

        <!-- ══════════════ FOOTER ══════════════ -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="Since 1934 • Mattighofen, Austria"
                android:textColor="#444444"
                android:textSize="11sp" />

        <View
                android:layout_width="80dp"
                android:layout_height="3dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_gradient_line" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.3"
                android:text="READY TO RACE"
                android:textColor="#FF6600"
                android:textSize="10sp"
                android:textStyle="bold" />

    </LinearLayout>
</ScrollView>