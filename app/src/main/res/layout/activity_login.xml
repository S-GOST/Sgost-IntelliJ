<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0D0D0D"
            android:fillViewport="true"
            tools:context="com.example.sgost.LoginActivity">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal">

        <!-- LOGO -->
        <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:src="@mipmap/rock"
                android:scaleType="centerInside"
                android:contentDescription="Logo SGOST" />

        <!-- TÍTULO PRINCIPAL: SGOST -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SGOST"
                android:textColor="#FF6600"
                android:textSize="64sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:shadowColor="#FF6600"
                android:shadowRadius="6"
                android:shadowDx="0"
                android:shadowDy="0"
                android:layout_marginBottom="16dp" />

        <!-- SUBTÍTULO: Iniciar Sesión en SGOST (UNA SOLA LÍNEA, ORDENADO) -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar Sesión en SGOST"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:letterSpacing="0.3"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

        <!-- SLOGAN: Ride. Connect. Conquer. (con puntos para mejor estilo) -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ride. Connect. Conquer."
                android:textColor="#AAAAAA"
                android:textSize="15sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginBottom="40dp" />

        <!-- TARJETA DEL FORMULARIO (MaterialCardView) -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                android:layout_marginBottom="32dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">

                <!-- Campo CORREO con TextInputLayout -->
                <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="#2C2C2C"
                        app:hintTextColor="#FF6600"
                        app:boxStrokeColor="#FF6600"
                        android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="CORREO ELECTRÓNICO"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#777777"
                            android:textSize="16sp"
                            android:inputType="textEmailAddress"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo CONTRASEÑA con TextInputLayout y toggle -->
                <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="#2C2C2C"
                        app:hintTextColor="#FF6600"
                        app:boxStrokeColor="#FF6600"
                        app:endIconMode="password_toggle"
                        android:layout_marginBottom="32dp">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="CONTRASEÑA"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#777777"
                            android:textSize="16sp"
                            android:inputType="textPassword"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón Iniciar Sesión -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:backgroundTint="#FF6600"
                        android:text="INICIAR SESIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        app:cornerRadius="12dp"
                        android:elevation="4dp" />

                <!-- Mensaje de error -->
                <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="#33FF0000"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text=""
                        android:textColor="#FF5555"
                        android:textSize="14sp"
                        android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FOOTER -->
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Since 1994 • Multigolfers, Austria"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginBottom="12dp" />

            <View
                    android:layout_width="100dp"
                    android:layout_height="3dp"
                    android:background="#FF6600"
                    android:layout_marginBottom="12dp" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY TO RACE"
                    android:textColor="#FF6600"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>