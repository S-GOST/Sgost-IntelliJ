<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0D0D"
        android:fillViewport="true"
        tools:context="com.example.sgost.DashboardActivityTecnicos">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

        <!-- ══════════════ HEADER ══════════════ -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SGOST TÉCNICO"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FF6600"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de Trabajo"
                android:textSize="14sp"
                android:textColor="#888888"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="24dp"/>

        <!-- ══════════════ CARD USUARIO ══════════════ -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@mipmap/iconoadministradores"
                            android:scaleType="centerCrop"
                            android:contentDescription="Icono de usuario"
                            android:layout_marginEnd="12dp" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/tvBienvenidaTec"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hola, Técnico"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>

                        <TextView
                                android:id="@+id/tvNombreTec"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Técnico • En sesión"
                                android:textColor="#FF6600"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Datos reales de BD -->
                <TextView android:id="@+id/tvEmailTec" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginTop="12dp" android:paddingStart="8dp"/>
                <TextView android:id="@+id/tvTelefonoTec" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginTop="4dp" android:paddingStart="8dp"/>
                <TextView android:id="@+id/tvUbicacionTec" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginTop="4dp" android:paddingStart="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════ GRID DE MENÚ (FLUJO TÉCNICO) ══════════════ -->
        <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMisOrdenes"
                    android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A" app:cardCornerRadius="12dp" app:cardElevation="3dp" app:strokeColor="#2A2A2A" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIS ÓRDENES" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trabajos asignados" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardActualizar"
                    android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A" app:cardCornerRadius="12dp" app:cardElevation="3dp" app:strokeColor="#2A2A2A" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTUALIZAR" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estado de trabajos" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHistorial"
                    android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A" app:cardCornerRadius="12dp" app:cardElevation="3dp" app:strokeColor="#2A2A2A" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📜" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HISTORIAL" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trabajos completados" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPerfil"
                    android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A" app:cardCornerRadius="12dp" app:cardElevation="3dp" app:strokeColor="#2A2A2A" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MI PERFIL" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Datos personales" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNotificaciones"
                    android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A" app:cardCornerRadius="12dp" app:cardElevation="3dp" app:strokeColor="#2A2A2A" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOTIFICACIONES" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alertas del sistema" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAyuda"
                    android:layout_width="0dp" android:layout_height="110dp"
                    android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A1A" app:cardCornerRadius="12dp" app:cardElevation="3dp" app:strokeColor="#2A2A2A" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❓" android:textSize="28sp" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AYUDA / SOPORTE" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asistencia técnica" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- ══════════════ BOTÓN LOGOUT ══════════════ -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutTec"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CERRAR SESIÓN"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-black"
                android:backgroundTint="#8B0000"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="24dp"/>

        <!-- ══════════════ FOOTER ══════════════ -->
        <View android:layout_width="60dp" android:layout_height="3dp" android:background="@drawable/bg_gradient_line" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SGOST • TECH PANEL" android:textSize="10sp" android:textColor="#FF6600" android:textStyle="bold" android:letterSpacing="0.2" android:fontFamily="sans-serif-medium" android:layout_marginBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>